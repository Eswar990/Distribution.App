                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox18">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Sub./Description: The total amount collected for the month of " &amp;
IIf(
    IsNothing(First(Fields!PostingDate.Value, "DataSet_Result")),
    "",
    Format(CDate(First(Fields!PostingDate.Value, "DataSet_Result")), "MMMM yyyy")
) &amp;
" is " &amp; FormatNumber(First(Fields!UnitPrice.Value, "DataSet_Result"), 0) &amp; " AED and Commission payable for the same is " &amp;
FormatNumber(First(Fields!UnitPrice.Value, "DataSet_Result"), 0) &amp; " AED only"</Value>
